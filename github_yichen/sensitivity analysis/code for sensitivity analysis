class KLA_Material_Loader:
    def __init__(self, wavelengths):
        self.target_wl = wavelengths
        self.materials = {}

    def load_from_file(self, filename, mat_name):
        if not os.path.exists(filename):
            print(f"[WARNING] File not found: {filename}. Using default for {mat_name}.")
            return False
        try:
            data = []
            with open(filename, 'r') as f:
                for line in f:
                    parts = line.strip().split()
                    if not parts: continue
                    if parts[0].replace('.', '', 1).isdigit() and len(parts) >= 3:
                        data.append([float(parts[0]), float(parts[1]), float(parts[2])])
            data = np.array(data)
            data = data[data[:, 0].argsort()]
            f_n = interp1d(data[:, 0], data[:, 1], kind='linear', fill_value="extrapolate")
            f_k = interp1d(data[:, 0], data[:, 2], kind='linear', fill_value="extrapolate")
            self.materials[mat_name] = f_n(self.target_wl) + 1j * f_k(self.target_wl)
            return True
        except Exception as e:
            print(f"[ERROR] {filename}: {e}")
            return False

    def get_refractive_index(self, name):
        return self.materials.get(name)


class TMM_Simulator_7Layer:
    def __init__(self, data_dir='../simulator/data'):
        self.wavelengths = np.arange(200, 1001, 1.0)
        self.k0_list     = 2 * np.pi / self.wavelengths
        self.loader      = KLA_Material_Loader(self.wavelengths)
        print("Loading KLA material library...")
        self.has_si    = self.loader.load_from_file(os.path.join(data_dir, 'si.txt'),    'Si')
        self.has_sio2  = self.loader.load_from_file(os.path.join(data_dir, 'sio2.txt'),  'SiO2')
        self.has_si3n4 = self.loader.load_from_file(os.path.join(data_dir, 'si3n4.txt'), 'Si3N4')
        self.n_Air   = np.ones_like(self.wavelengths, dtype=np.complex128)
        self.n_SiO2  = self.loader.get_refractive_index('SiO2')
        if self.n_SiO2  is None: self.n_SiO2  = np.full_like(self.wavelengths, 1.46+0j, dtype=np.complex128)
        self.n_Si3N4 = self.loader.get_refractive_index('Si3N4')
        if self.n_Si3N4 is None: self.n_Si3N4 = np.full_like(self.wavelengths, 2.02+0j, dtype=np.complex128)
        self.n_Si    = self.loader.get_refractive_index('Si')
        if self.n_Si    is None: self.n_Si    = np.full_like(self.wavelengths, 4.00+0j, dtype=np.complex128)
        print("Material library loaded.\n")

    def calculate_spectrum(self, d_list):
        layers = [
            (self.n_Air,   0),
            (self.n_SiO2,  d_list[0]), (self.n_Si3N4, d_list[1]),
            (self.n_SiO2,  d_list[2]), (self.n_Si3N4, d_list[3]),
            (self.n_SiO2,  d_list[4]), (self.n_Si3N4, d_list[5]),
            (self.n_SiO2,  d_list[6]), (self.n_Si,    0),
        ]
        M00 = np.ones_like(self.wavelengths,  dtype=np.complex128)
        M11 = np.ones_like(self.wavelengths,  dtype=np.complex128)
        M01 = np.zeros_like(self.wavelengths, dtype=np.complex128)
        M10 = np.zeros_like(self.wavelengths, dtype=np.complex128)
        N_curr = layers[0][0]
        for i in range(1, len(layers)):
            N_next, d_next = layers[i]
            r     = (N_curr - N_next) / (N_curr + N_next)
            inv_t = (N_curr + N_next) / (2 * N_curr)
            m00=(M00+M01*r)*inv_t; m01=(M00*r+M01)*inv_t
            m10=(M10+M11*r)*inv_t; m11=(M10*r+M11)*inv_t
            M00,M01,M10,M11 = m00,m01,m10,m11
            if i < len(layers)-1:
                phi = self.k0_list * N_next * d_next
                M00*=np.exp(-1j*phi); M01*=np.exp(1j*phi)
                M10*=np.exp(-1j*phi); M11*=np.exp(1j*phi)
            N_curr = N_next
        return np.abs(M10/M00)**2


# ==============================================================================
# Helper functions
# ==============================================================================
def compute_rmse_pct(spec_ref, spec_perturbed):
    rmse = np.sqrt(np.mean((spec_perturbed - spec_ref)**2))
    return rmse / np.mean(spec_ref) * 100

def quadratic_full(x, a, b):
    return a * x**2 + b

def linear_abs(x, a, b):
    return a * x + b

def check_monotonic(delta_range, rmse_values, threshold):
    mask      = ~np.isnan(rmse_values)
    delta_c   = delta_range[mask]
    rmse_c    = rmse_values[mask]
    in_thresh = rmse_c < threshold
    if in_thresh.sum() < 3:
        return False, False, False
    delta_r = delta_c[in_thresh]
    rmse_r  = rmse_c[in_thresh]
    left_ok = right_ok = True
    left_mask = delta_r < 0
    if left_mask.sum() > 1:
        idx = np.argsort(delta_r[left_mask])
        left_ok = bool(np.all(np.diff(rmse_r[left_mask][idx]) <= 0))
    right_mask = delta_r > 0
    if right_mask.sum() > 1:
        idx = np.argsort(delta_r[right_mask])
        right_ok = bool(np.all(np.diff(rmse_r[right_mask][idx]) >= 0))
    return left_ok and right_ok, left_ok, right_ok

def find_x_limit(simulator, ref_thicknesses, layer_idx, ref_thickness,
                 max_rmse=10.0, delta_check=np.arange(-50, 51, 1)):
    ref_spec = simulator.calculate_spectrum(ref_thicknesses)
    rmse_vals = []
    for delta in delta_check:
        perturbed = ref_thicknesses.copy()
        perturbed[layer_idx] = ref_thickness + delta
        if perturbed[layer_idx] <= 0:
            rmse_vals.append(np.nan); continue
        rmse_vals.append(compute_rmse_pct(ref_spec, simulator.calculate_spectrum(perturbed)))
    rmse_vals = np.array(rmse_vals)
    within = np.where(rmse_vals <= max_rmse)[0]
    if len(within) > 0:
        return max(abs(delta_check[within[0]]), abs(delta_check[within[-1]]))
    return 20

def compute_heatmap(simulator, ref_thicknesses, ref_spectrum,
                    idx_a, ref_a, idx_b, ref_b, lim_a, lim_b, step=1):
    da = np.arange(-lim_a, lim_a+1, step)
    db = np.arange(-lim_b, lim_b+1, step)
    hm = np.zeros((len(da), len(db)))
    for i, d1 in enumerate(da):
        for j, d2 in enumerate(db):
            perturbed = ref_thicknesses.copy()
            perturbed[idx_a] = ref_a + d1
            perturbed[idx_b] = ref_b + d2
            if perturbed[idx_a] <= 0 or perturbed[idx_b] <= 0:
                hm[i,j] = np.nan
            else:
                hm[i,j] = compute_rmse_pct(ref_spectrum, simulator.calculate_spectrum(perturbed))
        if i % 5 == 0: print(f'  Row {i+1}/{len(da)} done')
    return da, db, hm

def plot_heatmap(ax, da, db, hm, name_a, name_b, title, zoom_y_max=10.0):
    im = ax.imshow(hm, extent=[db[0],db[-1],da[0],da[-1]], origin='lower',
                   aspect='auto', cmap='RdYlGn_r', vmin=0, vmax=zoom_y_max)
    plt.colorbar(im, ax=ax, label='RMSE (%)')
    try:
        cs3 = ax.contour(db, da, hm, levels=[3.0], colors=['red'], linewidths=2)
        ax.clabel(cs3, fmt='3%%', fontsize=9)
    except: pass
    try:
        cs5 = ax.contour(db, da, hm, levels=[5.0], colors=['orange'], linewidths=2)
        ax.clabel(cs5, fmt='5%%', fontsize=9)
    except: pass
    ax.axhline(y=0, color='white', linestyle='--', linewidth=1, alpha=0.5)
    ax.axvline(x=0, color='white', linestyle='--', linewidth=1, alpha=0.5)
    ax.plot(0, 0, 'w*', markersize=12, label='Reference (RMSE=0)', zorder=5)
    ax.set_xlabel(f'ΔL of {name_b} (nm)', fontsize=11)
    ax.set_ylabel(f'ΔL of {name_a} (nm)', fontsize=11)
    ax.set_title(title, fontsize=11); ax.legend(fontsize=9)
    return im


