for layer_idx in range(7):
    name = layer_names[layer_idx]
    ref  = ref_thicknesses[layer_idx]

    # Recompute RMSE for this layer (same as Cell 12)
    rmse_vals = []
    for delta in ZOOM_DELTA:
        perturbed = ref_thicknesses.copy()
        perturbed[layer_idx] = ref + delta
        if perturbed[layer_idx] <= 0:
            rmse_vals.append(np.nan); continue
        rmse_vals.append(compute_rmse_pct(ref_spectrum,
                         simulator.calculate_spectrum(perturbed)))
    rmse_vals = np.array(rmse_vals)

    def find_crossing(x_arr, y_arr, threshold, side='right'):
        """
        Linear interpolation to find exact x where y crosses threshold.
        side='right': find first crossing going positive (ascending RMSE)
        side='left' : find first crossing going negative (ascending RMSE)
        """
        if side == 'right':
            mask = x_arr >= 0
        else:
            mask = x_arr <= 0
            x_arr = x_arr[mask][::-1]   # flip so we go away from 0
            y_arr = y_arr[mask][::-1]
            x_arr = x_arr; y_arr = y_arr

        x_s = x_arr[mask] if side == 'right' else x_arr
        y_s = y_arr[mask] if side == 'right' else y_arr

        above = y_s >= threshold
        if not above.any():
            return None   # never reaches threshold in this range
        if above[0]:
            return x_s[0]   # already above at ΔL=0 (unusual)

        idx = np.where(above)[0][0]
        # Linear interpolation between last below and first above
        x1, x2 = x_s[idx-1], x_s[idx]
        y1, y2 = y_s[idx-1], y_s[idx]
        x_cross = x1 + (threshold - y1) * (x2 - x1) / (y2 - y1)
        return x_cross

    row_vals = [name, ref]
    for thresh in [5.0, 3.0]:
        # Left crossing (negative ΔL side)
        x_left  = find_crossing(ZOOM_DELTA, rmse_vals, thresh, side='left')
        # Right crossing (positive ΔL side)
        x_right = find_crossing(ZOOM_DELTA, rmse_vals, thresh, side='right')

        left_str  = f'{x_left:+.2f}nm'  if x_left  is not None else 'out of range'
        right_str = f'{x_right:+.2f}nm' if x_right is not None else 'out of range'
        row_vals += [left_str, right_str]

